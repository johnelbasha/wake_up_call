<!DOCTYPE html>
<html>
  <head>
    <style>
      .price {
        color: red;
        font-weight: bold;
      }
    </style>
  </head>
  <body>
    <div style="max-width: 600px; margin: 0 auto; font-family: Arial, sans-serif;">
      <h1>Good morning!</h1>

      <p>Here is your daily update.</p>

      <div style="padding: 20px; background: #f5f5f5; border-radius: 8px;">
        <p style="margin: 0;">Gold price</p>

        <h2 class="price", style="margin: 8px 0 0;">
          $<%= @gold_price %> USD
        </h2>

         <h2>Expiring Within 3 Months</h2>
         <#% @expirables.each do | expirable | %>
           <p><#%= expirable.name %> expires in <#%= expirable.days %> days</p>
         <#% end %>
      </div>
    </div>
  </body>
</html>